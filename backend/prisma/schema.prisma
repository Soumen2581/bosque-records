generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Release {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  releaseDate DateTime
  coverImage  String
  featured    Boolean  @default(false)
  price       Float?
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id])
  tracks      Track[]
  tags        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("releases")
}

model Artist {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  bio         String?
  avatar      String?
  socialLinks String?
  releases    Release[]
  events      Event[]   @relation("EventArtists")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@map("artists")
}

model Track {
  id        String  @id @default(cuid())
  title     String
  duration  Int     // in seconds
  audioFile String?
  preview   String? // preview URL
  order     Int
  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  
  @@map("tracks")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  date        DateTime
  endDate     DateTime?
  location    String
  venue       String?
  image       String?
  ticketUrl   String?
  featured    Boolean   @default(false)
  artists     Artist[]  @relation("EventArtists")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@map("events")
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  price        Float
  salePrice    Float?
  images       String   // JSON array
  category     String   // "clothing", "vinyl", "digital", "accessories", "art", "cds"
  productType  String   @default("physical") // "physical", "digital", "vinyl"
  inStock      Boolean  @default(true)
  quantity     Int      @default(0)
  sku          String?
  weight       Float?   // grams for shipping calc
  dimensions   String?  // JSON {width, height, depth} in cm
  variants     String?  // JSON {sizes: ["S","M","L"], colors: ["black"]}
  bandcampUrl String?  // for music redirect
  downloadMp3  String?  // URL for MP3 download (digital products)
  downloadWav  String?  // URL for WAV download (digital products)
  streamUrl    String?  // URL for streaming (digital products)
  featured     Boolean  @default(false)
  tags         String   // comma-separated
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  orderItems         OrderItem[]
  digitalLibraryItems DigitalLibrary[]
  
  @@map("products")
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  phone        String?
  addresses    String?  // JSON array of saved addresses
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  orders            Order[]
  digitalLibraryItems DigitalLibrary[]
  
  @@map("customers")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id])
  customerEmail   String
  customerName    String?
  status          String      @default("pending") // pending, paid, processing, shipped, delivered, cancelled, refunded
  paymentMethod   String?     // stripe, sepa, bank_transfer
  paymentId       String?     // external payment reference
  subtotal        Float
  shippingCost    Float       @default(0)
  total           Float
  shippingAddress String?      // JSON
  billingAddress  String?     // JSON
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  items OrderItem[]
  
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  productImage String
  quantity    Int
  price       Float   // price at time of purchase
  variant     String? // size/color at purchase
  
  @@map("order_items")
}

model DigitalLibrary {
  id        String   @id @default(cuid())
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  downloadCountMp3 Int @default(0)
  downloadCountWav Int @default(0)
  lastDownloadAt   DateTime?
  downloadExpiry   DateTime?  // when download links expire
  createdAt   DateTime @default(now())
  
  @@unique([customerId, productId])
  @@map("digital_library")
}

model Booking {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  eventType   String
  date        DateTime
  message     String?
  status      String   @default("pending") // pending, confirmed, declined
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("bookings")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  
  @@map("newsletter")
}

model Artwork {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  artist      String
  category    String
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  @@map("artworks")
}
